#!/usr/bin/env bash
# Launcher: always runs the toolkit with the workspace venv.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# PYTHONPATH rather than trusting rag_toolkit.pth: on macOS a .rag inside an
# iCloud container is flagged UF_HIDDEN, and CPython 3.13+ skips hidden .pth
# files, so the toolkit would be present but unimportable.
export PYTHONPATH="$here/toolkit${PYTHONPATH:+:$PYTHONPATH}"
exec "/Users/Khaled.Alabsi/.local/share/rag/my-wiki/venv/bin/python" -m rag_toolkit.cli --rag-dir "$here" "$@"
